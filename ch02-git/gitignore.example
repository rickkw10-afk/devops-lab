# 복사해서 repository 루트에 .gitignore 로 둔다.
# 규칙: 만들어지는 것(build 결과), 개인 설정(IDE), 비밀(.env)은 올리지 않는다.

# build 결과 — 소스만 있으면 언제든 다시 만들 수 있다
build/
out/
target/
*.class
*.jar
# 예외: wrapper jar 는 있어야 ./gradlew 가 돈다 (주석은 반드시 따로 한 줄에)
!gradle/wrapper/gradle-wrapper.jar
.gradle/

# IDE·OS 가 만드는 파일
.idea/
*.iml
.vscode/
.DS_Store

# 비밀 — 한 번이라도 push 하면 history 에 남는다
.env
*.pem
*.key
application-local.yml

# 로그
*.log
